*.a

# Temporary state and secrets.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
*.tmp
*.swp
*.pid
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
