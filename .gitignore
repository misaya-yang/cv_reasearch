# Local datasets, models, downloaded source trees and Python runtimes.
**/assets/
**/third_party/
**/*_source/
**/datasets/
**/checkpoints/
**/cache/
**/.cache/
**/.venv/
**/venv/
**/node_modules/

# Results: small text files are versioned in place (keep each under 1 MB); anything else under results/ stays local.
**/results/**
!**/results/**/
!**/results/**/*.json
!**/results/**/*.log
!**/results/**/*.csv
!**/results/**/*.txt
**/logs/

# Model/feature tensors, archives, generated media and native build products.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.npz
*.npy
*.h5
*.hdf5
*.pkl
*.pickle
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.mp4
*.avi
*.png
*.jpg
*.jpeg
*.so
*.dylib
*.o
*.a

# Temporary state and secrets.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
*.tmp
*.swp
*.pid
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json

